# --- Required for live AI chat + brain graph (FREE, no card) ---
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# --- Required for login sessions (just make up any random long string) ---
JWT_SECRET=change-this-to-any-random-long-string

# --- Optional: enables "Continue with Google" on the login screen ---
# Get a free Client ID from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application -> add
#  http://localhost:5173 as an Authorized JavaScript origin)
# Leave both blank to skip Google sign-in — email/password still works fully.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

PORT=3001
